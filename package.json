{
  "name": "roadmap-live",
  "version": "0.2.0",
  "description": "Live browser view of a roadmap.json maintained by coding agents, synced with GitHub pull requests",
  "license": "MIT",
  "bin": {
    "roadmap-live": "roadmap-live.js"
  },
  "main": "roadmap-live.js",
  "files": [
    "roadmap-live.js",
    "src/",
    "action.yml",
    "examples/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node roadmap-live.js",
    "check": "node roadmap-live.js --check",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "roadmap",
    "coding-agents",
    "claude-code",
    "codex",
    "github-actions",
    "pull-requests",
    "sse",
    "kanban"
  ]
}
